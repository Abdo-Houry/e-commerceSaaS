{
  "name": "@matjari/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "db:create": "ts-node --transpile-only src/scripts/create-db.ts",
    "dev": "ts-node-dev --respawn --transpile-only --watch ../packages/shared/dist/cjs src/server.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/scripts/migrate.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "seed": "ts-node --transpile-only src/scripts/seed-demo.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -p -d src/config/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
    "test": "node --no-experimental-strip-types --require ts-node/register/transpile-only --require ./test/setup-env.ts --test --test-concurrency=1 test/*.test.ts",
    "make-admin": "ts-node --transpile-only src/scripts/make-admin.ts",
    "db:reset": "ts-node --transpile-only src/scripts/reset-db.ts",
    "seed:sample": "ts-node --transpile-only src/scripts/seed-sample.ts",
    "bootstrap:demo": "ts-node --transpile-only src/scripts/bootstrap-demo.ts"
  },
  "dependencies": {
    "@matjari/shared": "^0.1.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.3"
  }
}
