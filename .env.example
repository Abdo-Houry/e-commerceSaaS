# ─── General ────────────────────────────────────────────
NODE_ENV=development

# ─── API (backend) ──────────────────────────────────────
API_PORT=4000
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public base URL of the API (used to build upload URLs)
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web app (used for storefront links / QR codes)
WEB_PUBLIC_URL=http://localhost:3000
# URL the API uses to reach the web app server-side (on-demand ISR revalidation)
WEB_INTERNAL_URL=http://localhost:3000
# Shared secret between API and web for /api/revalidate
REVALIDATE_SECRET=change-me-revalidate
# Timezone for "today" / "this month" in stats and order date filters
APP_TIMEZONE=Asia/Damascus

# ─── Database (docker-compose uses the same values) ────
# Managed hosts (Render, Railway, Neon…) provide one connection string; when set it wins over DB_*
# DATABASE_URL=postgresql://user:password@host:5432/matjari
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=matjari
DB_PASSWORD=matjari
DB_NAME=matjari
# Set to true for a managed database that requires TLS
DB_SSL=false

# ─── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Mail (password reset) ──────────────────────────────
# Leave SMTP_HOST empty in development: emails (password reset links) are printed to the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Matjari <no-reply@matjari.local>"

# ─── Uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# ─── Web (frontend) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# API URL used by Next.js server components (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000/api
# Public URL of the web app (canonical links, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
